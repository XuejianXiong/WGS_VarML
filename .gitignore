# ==============================================================================
# WGS_VarML Project Gitignore
# ==============================================================================

# --- Bioinformatics Data & Large Files ---
# Never commit raw or processed genomic data (VCFs, FASTAs, Indexes)
data/**
results/**
!results/*.html
!results/models
!results/pipeline_info
*.vcf.gz
*.vcf.gz.tbi
*.vcf.gz.md5
*.fa
*.fa.gz
*.fai
*.parquet
*.stats.txt

# --- Nextflow & Pipeline Metadata ---
# Nextflow creates these directories during runtime
.nextflow/
.nextflow.log*
work/
.nextflow.db/

# --- Python & Environments ---
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/
.env

# --- ML & Experiment Tracking ---
# Prevents committing heavy model weights or local logs
*.joblib
*.pkl
*.model
*.h5
mlruns/
lightning_logs/

# --- IDEs & OS Specific ---
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# --- VEP & Annotation Caches ---
# VEP caches are several GBs; keep them local
.vep/
ensembl-vep*/
*.zip

# --- Temporary & Backup Files ---
bk/
tmp/
temp/
*.bak