/*
========================================================================================
    WGS_VarML Configuration Profile
========================================================================================
    Author: Xuejian Xiong
    Description: Production-grade config for variant ML pipeline.
----------------------------------------------------------------------------------------
*/

params {
    // 1. Core Inputs (Expected to be overridden by input.json)
    input_vcf        = "${projectDir}/data/raw/clinvar.vcf.gz"
    ref_fasta        = "${projectDir}/data/reference/GRCh38.fa.gz"
    outdir           = "${projectDir}/results"
    publish_dir_mode = 'copy'

    // 2. VEP Specifics
    vep_threads      = 4
    vep_assembly     = 'GRCh38'
    
    // 3. Smart VEP Cache Logic
    // If input.json says "DEFAULT", we resolve to the user's home directory.
    vep_cache_raw    = "DEFAULT" 
    vep_cache        = (params.vep_cache_raw == "DEFAULT") ? "${HOME}/.vep" : params.vep_cache_raw

    // 4. Global Resource Limits (Guards against over-allocation)
    max_cpus         = 12
    max_memory       = '32.GB'
    max_time         = '48.h'
}

// --- Execution Profiles ---
profiles {
    docker {
        docker.enabled         = true
        docker.autoMounts      = true
        docker.userEmulation   = true
        // Ensures proper file permissions on host machine
        docker.runOptions      = '-u \$(id -u):\$(id -g)'
    }
    
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
}

// --- Process Resource Management ---
process {
    // Dynamic Retry Logic: If a process fails with OOM (Error 137), retry with more RAM
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1

    // Resource Labels used in .nf files
    withLabel:process_low {
        cpus   = { check_max( 2 * task.attempt, 'cpus' ) }
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
    }
    withLabel:process_medium {
        cpus   = { check_max( 4 * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
    }
    withLabel:process_high {
        cpus   = { check_max( params.vep_threads * task.attempt, 'cpus' ) }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
    }
}

// --- Reporting & Traceability ---
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
}

// --- Helper Functions ---
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   --- ERROR [Nextflow] --- Max memory '${params.max_memory}' invalid. Using: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   --- ERROR [Nextflow] --- Max cpus '${params.max_cpus}' invalid. Using: $obj"
            return obj
        }
    }
}