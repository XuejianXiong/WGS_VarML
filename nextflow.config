/*
========================================================================================
    WGS_VarML Pipeline Config
========================================================================================
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

params {
    // Pipeline Inputs
    input_vcf          = "${projectDir}/data/raw/clinvar.vcf.gz"
    ref_fasta          = "${projectDir}/data/reference/GRCh38.fa.gz"
    vep_cache          = "${HOME}/.vep"
    
    // Output Options
    outdir             = "${projectDir}/results"
    publish_dir_mode   = 'copy'
    
    // Resource Defaults
    max_cpus           = 8
    max_memory         = '16.GB'
    max_time           = '24.h'
}

// 1. Global Process Configuration
process {
    // Default error strategy: retry on transient failures
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2

    // Default resource allocation
    cpus   = { check_max( 2 * task.attempt, 'cpus' ) }
    memory = { check_max( 4.GB * task.attempt, 'memory' ) }

    // Process-specific overrides
    withName: 'PREPROCESS_VCF' {
        cpus   = { check_max( 2 * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
    }

    withName: 'RUN_VEP' {
        container = 'ensemblorg/ensembl-vep:latest'
        cpus      = { check_max( 4 * task.attempt, 'cpus' ) }
        memory    = { check_max( 16.GB * task.attempt, 'memory' ) }
    }
}

// 2. Execution Profiles (The "Senior" touch)
profiles {
    debug { process.beforeScript = 'echo $HOSTNAME' }
    
    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        docker.autoMounts      = true
        // Fixes potential permission issues on shared drives
        docker.runOptions      = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    slurm {
        process.executor       = 'slurm'
        process.queue          = 'standard'
    }
}

// 3. Introspection & Reporting
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.svg"
}

// 4. Function to ensure resources don't exceed system limits
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   --- ERROR [Nextflow] --- Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   --- ERROR [Nextflow] --- Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}