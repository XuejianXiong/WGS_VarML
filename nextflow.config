/*
========================================================================================
    WGS_VarML Configuration Profile
========================================================================================
    Author: Xuejian Xiong
    Description: Production-grade configuration for Whole Genome Sequencing 
                 Variant Pathogenicity Machine Learning Pipeline.
----------------------------------------------------------------------------------------
*/

params {
    // 1. Core Inputs & Project Metadata
    pipeline_name    = "WGS_VarML"
    input_vcf        = "${projectDir}/data/raw/clinvar.vcf.gz"
    ref_fasta        = "${projectDir}/data/reference/GRCh38.fa.gz"
    outdir           = "${projectDir}/results"
    publish_dir_mode = 'copy'

    // 2. Tool-Specific Parameters (VEP)
    vep_threads      = 4
    vep_assembly     = 'GRCh38'
    
    // 3. Environment-Aware Cache Logic
    // Resolves to ~/.vep unless overridden by input.json
    vep_cache_raw    = "DEFAULT" 
    vep_cache        = (params.vep_cache_raw == "DEFAULT") ? "${HOME}/.vep" : params.vep_cache_raw

    // 4. Resource Guardrails
    // Prevents local runs from exceeding host capacity
    max_cpus         = 12
    max_memory       = '32.GB'
    max_time         = '48.h'
}

// --- Execution Profiles ---
profiles {
    docker {
        docker.enabled         = true
        docker.autoMounts      = true
        docker.userEmulation   = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
    }
    
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
}

// --- Process Resource & Error Management ---
process {
    // Advanced Error Strategy: Retry on pre-emptible/transient failures (e.g., OOM)
    // 143: Sigterm, 137: OOM Killer, 104: Connection Reset, 134: Abort, 139: Segfault
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1

    // Resource Label Definitions
    withLabel:process_low {
        cpus   = { check_max( 2 * task.attempt, 'cpus' ) }
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
    }
    withLabel:process_medium {
        cpus   = { check_max( 4 * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
    }
    withLabel:process_high {
        cpus   = { check_max( params.vep_threads * task.attempt, 'cpus' ) }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
    }
}

// --- Instrumentation & Observability ---
// These blocks generate the HTML reports you need for audit/optimization
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}

dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}

// --- Helper Functions ---
/**
 * Ensures requested resources do not exceed global limits.
 */
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   --- ERROR [Nextflow] --- Max memory '${params.max_memory}' invalid. Using: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   --- ERROR [Nextflow] --- Max cpus '${params.max_cpus}' invalid. Using: $obj"
            return obj
        }
    }
}