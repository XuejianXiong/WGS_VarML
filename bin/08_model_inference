#!/usr/bin/env python3
"""
08_model_inference.py

Genomic ML Inference Engine for Variant Pathogenicity Prediction.
Used after 07_train_model to generate pathogenicity scores for unobserved 
variants using serialized artifacts (model, imputer, feature order).

Workflow (in order)
-------------------
1. Artifact Loading: Retrieves model.joblib, imputer.joblib, and feature_order.txt.
2. Feature Alignment: Reindexes input data to match the exact training schema.
3. Imputation: Applies the fitted imputer state to resolve missing genomic values.
4. Prediction: Generates pathogenicity probabilities and binary classifications.
5. Verification (Optional): If labels are present, calculates validation 
   metrics (AUC, MCC) to verify model consistency against truth sets.
6. Export: Saves results to model-specific Parquet and a professional HTML report.

Config (config.yaml under "inference")
--------------------------------------
Supports CLI overrides for output directory and model naming prefixes. 
Ensures zero-skew between training and production environments.

Usage
-----
    python3 src/08_model_inference.py <features.parquet> <model_dir> [--outdir DIR] [--label COL]

Example
-------
    python3 src/08_model_inference.py data/splits/clinvar.infer.parquet results/models/xgb/ --outdir results/
"""

import os
import argparse
import joblib
import pandas as pd
import numpy as np
import datetime
from sklearn.metrics import roc_auc_score, matthews_corrcoef, classification_report

def load_artifacts(model_dir):
    """Load the trained model and preprocessing states."""
    model_path = os.path.join(model_dir, 'model.joblib')
    imputer_path = os.path.join(model_dir, 'imputer.joblib')
    feature_path = os.path.join(model_dir, 'feature_order.txt')

    if not all(os.path.exists(p) for p in [model_path, imputer_path, feature_path]):
        raise FileNotFoundError(f"Required artifacts missing in {model_dir}")

    model = joblib.load(model_path)
    imputer = joblib.load(imputer_path)
    with open(feature_path, 'r') as f:
        feature_order = [line.strip() for line in f]
    
    return model, imputer, feature_order

def generate_html_report(metrics, report_text, out_path, model_name):
    """Generates a styled HTML report for both labeled and unlabeled inference."""
    
    # Conditional display for metrics grid (only if labels were present)
    metrics_html = ""
    if metrics['roc_auc'] != "N/A":
        metrics_html = f"""
        <div class="metrics-grid">
            <div class="metric-card">ROC-AUC: {metrics['roc_auc']}</div>
            <div class="metric-card">MCC: {metrics['mcc']}</div>
        </div>
        """

    # Conditional display for classification report
    report_html = ""
    if report_text:
        report_html = f"<h2>Verification Performance</h2><pre>{report_text}</pre>"
    else:
        report_html = "<h2>Verification</h2><p><i>No ground-truth labels provided. Performance metrics skipped.</i></p>"

    html_template = f"""
    <!DOCTYPE html>
    <html>
    <head>
        <title>Inference Report - {model_name}</title>
        <style>
            body {{ font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 40px; color: #2d3436; background-color: #f5f6fa; }}
            .container {{ max-width: 850px; margin: auto; border: 1px solid #dfe6e9; padding: 40px; border-radius: 12px; background-color: #ffffff; box-shadow: 0 10px 25px rgba(0,0,0,0.05); }}
            h1 {{ color: #0984e3; border-bottom: 3px solid #74b9ff; padding-bottom: 15px; margin-top: 0; }}
            .metadata {{ background: #f1f2f6; padding: 20px; border-radius: 8px; margin-bottom: 25px; font-size: 0.95em; border-left: 5px solid #0984e3; }}
            .metrics-grid {{ display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 25px 0; }}
            .metric-card {{ background: #55efc4; color: #004d40; padding: 25px; text-align: center; border-radius: 8px; font-size: 1.3em; font-weight: bold; border: 1px solid #00b894; }}
            pre {{ background: #2d3436; color: #fab1a0; padding: 25px; border-radius: 8px; overflow-x: auto; font-family: 'Courier New', monospace; font-size: 0.9em; box-shadow: inset 0 2px 10px rgba(0,0,0,0.2); }}
            h2 {{ color: #2d3436; margin-top: 30px; font-size: 1.4em; }}
            .footer {{ margin-top: 50px; font-size: 0.85em; text-align: center; color: #b2bec3; border-top: 1px solid #eee; padding-top: 25px; }}
        </style>
    </head>
    <body>
        <div class="container">
            <h1>WGS_VarML Inference Summary</h1>
            
            <div class="metadata">
                <strong>Model:</strong> {model_name}<br>
                <strong>Timestamp:</strong> {metrics['timestamp']}<br>
                <strong>Input Data:</strong> {metrics['input_file']}<br>
                <strong>Artifact Path:</strong> {metrics['model_dir']}<br>
                <strong>Total Variants Scored:</strong> {metrics['sample_size']}
            </div>

            {metrics_html}
            {report_html}

            <div class="footer">
                Xuejian Xiong | WGS_VarML Bioinformatics Pipeline | Toronto, Canada
            </div>
        </div>
    </body>
    </html>
    """
    with open(out_path, 'w') as f:
        f.write(html_template)

def run_inference(input_path, model_dir, outdir, label_col):
    # 1. Load Data and Artifacts
    print(f"[*] Loading data from {input_path}...")
    df = pd.read_parquet(input_path)
    model, imputer, feature_order = load_artifacts(model_dir)
    
    result_df = df.copy()

    # 2. Feature Alignment
    # Ensure all required features exist for the model schema
    for col in feature_order:
        if col not in df.columns:
            df[col] = np.nan
    X = df[feature_order]

    # 3. Imputation
    print("[*] Applying imputation...")
    X_imputed = imputer.transform(X)

    # 4. Prediction
    print("[*] Running model inference...")
    probs = model.predict_proba(X_imputed)[:, 1]
    preds = (probs >= 0.5).astype(int)

    result_df['pathogenicity_prob'] = probs
    result_df['prediction'] = preds

    # 5. Build Metadata and Verification
    metrics = {
        "timestamp": datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "model_dir": os.path.relpath(os.path.abspath(model_dir), os.getcwd()),
        "input_file": os.path.basename(input_path),
        "sample_size": len(result_df),
        "roc_auc": "N/A",
        "mcc": "N/A"
    }

    report_text = None
    if label_col in result_df.columns:
        print(f"[*] Ground truth detected in '{label_col}'. Calculating verification metrics...")
        y_true = result_df[label_col]
        
        metrics["roc_auc"] = round(float(roc_auc_score(y_true, probs)), 4)
        metrics["mcc"] = round(float(matthews_corrcoef(y_true, preds)), 4)
        report_text = classification_report(y_true, preds)
    else:
        print("[!] No labels found. Generating standard inference report.")

    # 6. Export
    os.makedirs(outdir, exist_ok=True)
    model_name = os.path.basename(model_dir.rstrip('/'))

    if not model_name or model_name == '.':
        out_path = os.path.join(outdir, "predictions.csv")
        report_path = os.path.join(outdir, "prediction_report.html")
    else:
        out_path = os.path.join(outdir, f"{model_name}_predictions.csv")
        report_path = os.path.join(outdir, f"{model_name}.prediction_report.html")

    
    # Rename and filter for final CSV
    export_cols = ['chr', 'pos', 'ref', 'alt', 'pathogenicity_prob', 'prediction']
    
    # Ensure standard VCF columns exist in result_df
    for col in ['chr', 'pos', 'ref', 'alt']:
        if col not in result_df.columns:
            result_df[col] = "N/A"

    final_csv = result_df[export_cols].rename(columns={
        'pathogenicity_prob': 'pathogenicity_score',
        'prediction': 'predicted_label'
    })
    final_csv.to_csv(out_path, index=False, sep='\t') # Saving as tab-separated for bioinfo compatibility
    # Save results as Parquet
    #out_path = os.path.join(outdir, f"{model_name}_predictions.parquet")
    #final_csv.to_parquet(out_path, compression='snappy')
    print(f"[#] Predictions saved to {out_path}")

    # Save HTML Report
    generate_html_report(metrics, report_text, report_path, model_name)
    print(f"[#] Visual report generated at {report_path}")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="WGS_VarML Inference Engine")
    parser.add_argument("input", help="Input features in Parquet format")
    parser.add_argument("model_dir", help="Directory containing model artifacts")
    parser.add_argument("--outdir", default="results", help="Output directory")
    parser.add_argument("--label", default="clnsig_label", help="Label column for verification")
    
    args = parser.parse_args()
    
    try:
        run_inference(args.input, args.model_dir, args.outdir, args.label)
    except Exception as e:
        print(f"[!] Error during inference: {e}")
        exit(1)
